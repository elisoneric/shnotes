# ───────── App ─────────
NODE_ENV=production
# Public base URL (used in share links and emails), no trailing slash
APP_URL=https://notes.example.com
NEXT_TELEMETRY_DISABLED=1

# ───────── Database ─────────
POSTGRES_USER=shnotes
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=shnotes
# In docker-compose the host is the `db` service
DATABASE_URL=postgresql://shnotes:change-me-long-random@db:5432/shnotes?schema=public

# ───────── Auth ─────────
# 32+ bytes: openssl rand -base64 48
AUTH_SECRET=
# Seeds the single owner account on first boot
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
WORKSPACE_NAME=My Workspace

# ───────── Indunix AI ─────────
INDUNIX_API_KEY=
INDUNIX_BASE_URL=https://api.indunixai.com/v1
INDUNIX_MODEL=indunix-1-core

# ───────── Email (reader notifications) ─────────
# Provider: resend | smtp | none
MAIL_PROVIDER=resend
MAIL_FROM="My Notes <notes@example.com>"
RESEND_API_KEY=
# SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Rate limiting to avoid notification fatigue
NOTIFY_MIN_INTERVAL_MINUTES=60
NOTIFY_MAX_PER_DAY=3
