datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum WorkspaceRole {
  OWNER             // Final-say authority / Project Owner
  PRODUCT_OWNER     // Scoped Product Owner
  DEVELOPER         // Writes technical recommendations & executes implementation
  STAFF             // Core staff member / requester
  VIEWER            // Read-only observer
  // Backward-compatibility aliases
  HOO
  TECH_ASSISTANT
  COLLABORATOR
  REVIEWER_GUIDE
  CONTRIBUTOR
}

enum ProjectAccessLevel {
  PRODUCT_OWNER
  LEAD_DEV
  REVIEWER_REQUESTER
  VIEWER
  // Backward-compatibility aliases
  LEAD
  CONTRIBUTOR
  OBSERVER
}

enum TaskStage {
  PROPOSED              // Raised by requester / staff
  TA_REVIEW             // Triaged by Technical Assistant
  DEV_ASSESSMENT        // Awaiting Developer recommendation & architecture plan
  CONFIRMED_READY       // Scope approved and locked
  IN_PROGRESS           // Active development
  READY_FOR_TESTING     // Staging build ready with QA test notes
  APPROVED_CLEARED      // Testing signed off / Cleared
  ARCHIVED              // Retained in historical archive
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommentType {
  STANDARD_CHAT         // Operational discussion
  TA_SPEC_NOTE          // Reviewer and guide feedback
  DEV_RECOMMENDATION    // Technical and architectural proposal
  TESTING_FEEDBACK      // Verification feedback
  STAGE_CHANGE_AUDIT    // Automated governance audit trail
  AI_COPILOT_OUTPUT     // Indunix AI generated deliverables
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  logoUrl     String?
  members     WorkspaceMember[]
  projects    Project[]
  pages       Page[]
  invites     WorkspaceInvite[]
  version     Int               @default(1)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("workspaces")
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  name               String
  passwordHash       String
  avatarUrl          String?
  role               WorkspaceRole      @default(OWNER)
  isSystemAdmin      Boolean            @default(false)
  memberships        WorkspaceMember[]
  projectMemberships ProjectMember[]
  assignedTasks      Task[]             @relation("TaskAssignee")
  createdTasks       Task[]             @relation("TaskCreator")
  signoffs           TaskSignoff[]
  comments           TaskComment[]
  sessions           AuthSession[]
  pageCollaborations PageCollaborator[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(COLLABORATOR)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  key         String          // Ticket prefix e.g. EQ, HR
  description String?
  colorAccent String?         @default("#3b82f6") // Accent color
  workspaceId String?         // Nullable for personal standalone projects
  workspace   Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerName   String?         // Final Say Authority / Project Owner
  guideName   String?         // Project Guide / Reviewer
  stages      ProjectStage[]  // Dynamic customizable columns
  members     ProjectMember[]
  tasks       Task[]
  pages       Page[]          // Notes scoped to this specific project
  version     Int             @default(1)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("projects")
}

model ProjectStage {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String   // e.g. "Requests", "In Review", "In Dev", "Cleared"
  color       String   @default("#94a3b8")
  order       Float    @default(0.0)
  isCompleted Boolean  @default(false)
  tasks       Task[]

  @@index([projectId, order])
  @@map("project_stages")
}

model ProjectMember {
  id          String             @id @default(cuid())
  projectId   String
  project     Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevel ProjectAccessLevel @default(REVIEWER_REQUESTER)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id                  String        @id @default(cuid())
  projectTaskId       String        // Human identifier such as EQ-101
  title               String
  description         String?       @db.Text // Objective, business case, and requirements
  stage               TaskStage     @default(PROPOSED)
  stageId             String?
  projectStage        ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  priority            TaskPriority  @default(MEDIUM)
  dueDate             DateTime?

  // Universal Enterprise Governance Fields
  taReviewNotes       String?       @db.Text // Reviewer / Guide remarks
  devRecommendation   String?       @db.Text // Execution methodology & technical spec
  devConfirmedAt      DateTime?              // Scope lock timestamp
  qaTestNotes         String?       @db.Text // Deliverables, verification & testing criteria
  approvalSignoffNote String?       @db.Text // Final sign-off verification & acceptance notes
  signoffByName       String?                // Authority who signed off

  // Actors
  creatorId           String
  creator             User          @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId          String?
  assignee            User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  approverId          String?                // Designated final say authority for this task

  projectId           String
  project             Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relationships
  linkedPageId        String?
  linkedPage          Page?         @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)
  signoffs            TaskSignoff[]
  comments            TaskComment[]
  
  order               Float         @default(0.0)
  isArchived          Boolean       @default(false)
  version             Int           @default(1)
  deletedAt           DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([projectId, projectTaskId])
  @@index([projectId, stage, isArchived])
  @@index([projectId, stageId])
  @@map("tasks")
}

model TaskSignoff {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cleared   Boolean   @default(false)
  notes     String?   @db.Text
  clearedAt DateTime?

  @@unique([taskId, userId])
  @@map("task_signoffs")
}

model TaskComment {
  id          String      @id @default(cuid())
  taskId      String
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CommentType @default(STANDARD_CHAT)
  content     String      @db.Text
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Page {
  id              String             @id @default(cuid())
  title           String             @default("Untitled Document")
  icon            String?
  content         Json?
  isDiary         Boolean            @default(false)
  diaryDate       DateTime?
  isPrivate       Boolean            @default(false) // Private dev scratchpad notes
  layout          String?            @default("centered") // "centered" (768px) vs "full"
  fontFamily      String?            @default("sans")     // "sans" | "serif" | "mono"
  fontSize        String?            @default("normal")   // "small" | "normal"
  secretToken     String?            @unique
  workspaceId     String?            // Nullable for personal space standalone notes
  workspace       Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String?            // Notes scoped to specific project
  project         Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentId        String?
  parent          Page?              @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Page[]             @relation("PageTree")
  tasks           Task[]
  invites         WorkspaceInvite[]
  collaborators   PageCollaborator[]
  subscribers     PageSubscriber[]
  version         Int                @default(1)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([workspaceId, isDiary, diaryDate])
  @@index([projectId])
  @@map("pages")
}

model PageSubscriber {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([pageId, email])
  @@map("page_subscribers")
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  email       String?
  token       String        @unique
  role        WorkspaceRole @default(COLLABORATOR)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  allowGuest  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([token])
  @@index([workspaceId])
  @@map("workspace_invites")
}

model PageCollaborator {
  id        String        @id @default(cuid())
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @default(COLLABORATOR)
  createdAt DateTime      @default(now())

  @@unique([pageId, userId])
  @@index([userId])
  @@map("page_collaborators")
}

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

