datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum WorkspaceRole {
  OWNER             // Final-say authority / Project Owner
  REVIEWER_GUIDE    // Project Guide / Reviewer / Lead
  CONTRIBUTOR       // Contributor / Specialist / Developer
  VIEWER            // Auditor / Commenter / Viewer
  HOO               // Head of Operations alias
  TECH_ASSISTANT    // Technical Assistant alias
  DEVELOPER         // Developer alias
  COLLABORATOR      // Team member alias
}

enum TaskStage {
  PROPOSED              // Objective & Requirements proposed
  TA_REVIEW             // Under Review & Guidance
  DEV_ASSESSMENT        // Execution Plan & Scope Assessment
  CONFIRMED_READY       // Scope Approved & Locked
  IN_PROGRESS           // Active Execution
  READY_FOR_TESTING     // Verification & Deliverables
  APPROVED_CLEARED      // Final Sign-off & Completed
  ARCHIVED              // Moved to Archive
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CommentType {
  STANDARD_CHAT         // Operational discussion
  TA_SPEC_NOTE          // Reviewer and guide feedback
  DEV_RECOMMENDATION    // Technical and architectural proposal
  TESTING_FEEDBACK      // Verification feedback
  STAGE_CHANGE_AUDIT    // Automated governance audit trail
  AI_COPILOT_OUTPUT     // Indunix AI generated deliverables
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  logoUrl     String?
  members     WorkspaceMember[]
  projects    Project[]
  pages       Page[]
  invites     WorkspaceInvite[]
  version     Int               @default(1)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("workspaces")
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  role          WorkspaceRole     @default(OWNER)
  memberships   WorkspaceMember[]
  assignedTasks Task[]            @relation("TaskAssignee")
  createdTasks  Task[]            @relation("TaskCreator")
  comments      TaskComment[]
  sessions      AuthSession[]
  pageCollaborations PageCollaborator[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("users")
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(CONTRIBUTOR)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  key         String
  description String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerName   String?   // Final Say Authority / Project Owner
  guideName   String?   // Project Guide / Reviewer
  tasks       Task[]
  version     Int       @default(1)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
  @@map("projects")
}

model Task {
  id                  String       @id @default(cuid())
  projectTaskId       String       // Human identifier such as EQ-101
  title               String
  description         String?      @db.Text // Objective, business case, and requirements
  stage               TaskStage    @default(PROPOSED)
  priority            TaskPriority @default(MEDIUM)
  dueDate             DateTime?

  // Universal Enterprise Governance Fields
  taReviewNotes       String?      @db.Text // Reviewer / Guide remarks
  devRecommendation   String?      @db.Text // Execution methodology & technical spec
  devConfirmedAt      DateTime?             // Scope lock timestamp
  qaTestNotes         String?      @db.Text // Deliverables, verification & testing criteria
  approvalSignoffNote String?      @db.Text // Final sign-off verification & acceptance notes
  signoffByName       String?               // Authority who signed off

  // Actors
  creatorId           String
  creator             User         @relation("TaskCreator", fields: [creatorId], references: [id])
  assigneeId          String?
  assignee            User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  approverId          String?               // Designated final say authority for this task

  projectId           String
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relationships
  linkedPageId        String?
  linkedPage          Page?        @relation(fields: [linkedPageId], references: [id], onDelete: SetNull)
  comments            TaskComment[]
  
  order               Float        @default(0.0)
  isArchived          Boolean      @default(false)
  version             Int          @default(1)
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([projectId, projectTaskId])
  @@index([projectId, stage, isArchived])
  @@map("tasks")
}

model TaskComment {
  id          String      @id @default(cuid())
  taskId      String
  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        CommentType @default(STANDARD_CHAT)
  content     String      @db.Text
  version     Int         @default(1)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model Page {
  id              String      @id @default(cuid())
  title           String      @default("Untitled Document")
  icon            String?
  content         Json?
  isDiary         Boolean     @default(false)
  diaryDate       DateTime?
  secretToken     String?     @unique
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parentId        String?
  parent          Page?       @relation("PageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        Page[]            @relation("PageTree")
  tasks           Task[]
  invites         WorkspaceInvite[]
  collaborators   PageCollaborator[]
  version         Int               @default(1)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([workspaceId, isDiary, diaryDate])
  @@map("pages")
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  email       String?
  token       String        @unique
  role        WorkspaceRole @default(CONTRIBUTOR)
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pageId      String?
  page        Page?         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  allowGuest  Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([token])
  @@index([workspaceId])
  @@map("workspace_invites")
}

model PageCollaborator {
  id        String        @id @default(cuid())
  pageId    String
  page      Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @default(CONTRIBUTOR)
  createdAt DateTime      @default(now())

  @@unique([pageId, userId])
  @@index([userId])
  @@map("page_collaborators")
}

